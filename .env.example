# Copy to .env and fill in the secrets. .env is gitignored; this file is the template.
#
# How it is loaded:
#   * src/infra_telegram_server.py loads .env itself (python-dotenv).
#   * src/infra_server.py and src/agent_team/main.py read the process environment only,
#     so export the file first:  set -a; source .env; set +a
#   * Server settings are AKGENTIC_-prefixed fields of
#     akgentic.infra.server.settings.CommunitySettings; unset means the default shown.

# ── Provider credentials ─────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://app.tavily.com/ — web search tools
TAVILY_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# ── Team description generator ───────────────────────────────────────────────
# Small model that writes a team's first description from its first user message.
# Both must be set; leaving either unset turns the generator off.
AKGENTIC_DESCRIPTION_PROVIDER=openai
AKGENTIC_DESCRIPTION_MODEL=gpt-6-luna

# ── Server ───────────────────────────────────────────────────────────────────
# AKGENTIC_HOST=0.0.0.0
# AKGENTIC_PORT=8000
# AKGENTIC_LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR, CRITICAL
# AKGENTIC_CORS_ORIGINS=["*"]             # JSON list; [] disables the CORS middleware
# AKGENTIC_ADMIN_LIST_ALL_TEAMS=false
# AKGENTIC_CATALOG_MODEL_TYPE_PREFIXES=   # extra model_type prefixes, comma-separated (acme.,contoso.)
# AKGENTIC_SHUTDOWN_DRAIN_TIMEOUT=30
# AKGENTIC_SHUTDOWN_PRE_DRAIN_DELAY=0     # 5-10 behind a load balancer
# AKGENTIC_WS_READER_POOL_SIZE=256

# ── Community-tier storage ───────────────────────────────────────────────────
# AKGENTIC_CATALOG_PATH=data/catalog
# AKGENTIC_EVENT_STORE_PATH=data/event_store
# AKGENTIC_WORKSPACES_ROOT=workspaces
# AKGENTIC_CHANNEL_REGISTRY_PATH=data/channel_registry.yaml   # unset disables the registry
# AKGENTIC_AUTH_STRATEGY=noauth

# ── Optional integrations ────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=            # src/infra_telegram_server.py
# MCP_BEARER_TOKEN=              # bearer for the MCP server used by src/agent_team/tools.py
# LOGFIRE_TOKEN=                 # structured logging, https://logfire-eu.pydantic.dev/
